{
  "dependencies": {
    "chalk": "^5.6.2"
  },
  "devDependencies": {
    "@alienfast/logger": "^12.1.8",
    "clean-package": "^2.2.0",
    "tsdown": "^0.16.8",
    "vitest": "^4.0.14"
  },
  "exports": {
    ".": "./dist/index.js",
    "./initializeNodeLogger": "./dist/initializeNodeLogger.js",
    "./NodeLogWriter": "./dist/NodeLogWriter.js",
    "./NodeLogWriter.test": "./dist/NodeLogWriter.test.js",
    "./timestamp": "./dist/timestamp.js",
    "./*": "./*"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "main-types-note": "This is to appease tsc, types will be removed by clean-package. see https://github.com/rosskevin/ts-esm-workspaces/tree/bug-main-required-to-build#workaround ",
  "module": "./dist/index.js",
  "name": "@alienfast/logger-node",
  "peerDependencies": {
    "@alienfast/logger": "*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./*": "./*",
      "./initializeNodeLogger": "./dist/initializeNodeLogger.js",
      "./NodeLogWriter": "./dist/NodeLogWriter.js",
      "./NodeLogWriter.test": "./dist/NodeLogWriter.test.js",
      "./timestamp": "./dist/timestamp.js"
    }
  },
  "repository": "https://github.com/alienfast/logger",
  "scripts": {
    "build": "tsdown",
    "postpack": "clean-package restore -c ../../.clean-package.json",
    "prepack": "clean-package -c ../../.clean-package.json",
    "test": "vitest"
  },
  "sideEffects": [
    "./src/initializeNodeLogger.ts"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "12.1.8"
}
